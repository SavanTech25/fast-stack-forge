resources:
  pipelines:
    {{ name }}_pipeline:
      name: {{ name }}_pipeline
      catalog: ${var.catalog}
      schema: ${resources.schemas.{{ name }}_schema.name}
      channel: CURRENT
{% if serverless %}
      serverless: true
{% else %}
      clusters:
        - label: default
          autoscale:
            min_workers: 1
            max_workers: 2
{% endif %}
      libraries:
        - file:
            path: ../src/pipelines/{{ name }}_pipeline.py
