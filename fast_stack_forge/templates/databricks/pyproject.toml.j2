[project]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ runtime.python }},<{{ runtime.python_next }}"
# Spark and the Databricks libraries are provided by the runtime: keep this list for extra packages only
dependencies = []

[project.scripts]
main = "{{ name }}.main:main"

[dependency-groups]
dev = [
    "databricks-connect~={{ runtime.connect }}.0",
    "pytest>=8.0",
    "ruff>=0.6",
{% if pipeline %}
    "databricks-dlt>=0.3",
{% endif %}
{% if dbt %}
    "dbt-databricks>=1.9,<2.0",
{% endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 120
