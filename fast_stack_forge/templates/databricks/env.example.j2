# Copy to .env. The Makefile exports these variables (Databricks CLI, Databricks Connect, dbt).
# Auth comes from `make login` (~/.databrickscfg). Pick the profile to use:
DATABRICKS_CONFIG_PROFILE=DEFAULT
{% if serverless %}
# Run local Spark code (tests) on serverless compute
DATABRICKS_SERVERLESS_COMPUTE_ID=auto
{% else %}
# Run local Spark code (tests) on this cluster
DATABRICKS_CLUSTER_ID=
{% endif %}
{% if dbt %}

# dbt (make dbt-build). Host WITHOUT https://
DBT_HOST={{ host | replace("https://", "") }}
DBT_ACCESS_TOKEN=
DBT_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DBT_CATALOG={{ catalog }}
DBT_SCHEMA=dev
{% endif %}
