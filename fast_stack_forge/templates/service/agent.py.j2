{% import "_providers.j2" as p %}
"""{{ service_name }} — tool-calling agent (LangChain create_agent, {{ provider }})."""

import uuid
from datetime import datetime, timezone

from decouple import config
from langchain.agents import create_agent
from langchain_core.tools import tool
from langgraph.checkpoint.memory import InMemorySaver
{{ p.imports(provider) }}
SYSTEM_PROMPT = "You are a helpful assistant. Use the tools when they help you answer."


@tool
def current_time() -> str:
    """Return the current UTC date and time (ISO 8601)."""
    return datetime.now(timezone.utc).isoformat()


@tool
def word_count(text: str) -> int:
    """Count the words in a text."""
    return len(text.split())


class {{ service_name }}Service:
    def __init__(self):
        self.llm = {{ p.chat_model(provider) }}
        self.tools = [current_time, word_count]
        # InMemorySaver keeps each session's history in this process only (lost on restart,
        # not shared between workers). Swap it for a persistent checkpointer in production,
        # e.g. langgraph-checkpoint-postgres.
        self.agent = create_agent(
            self.llm,
            self.tools,
            system_prompt=SYSTEM_PROMPT,
            checkpointer=InMemorySaver(),
        )

    async def invoke(self, query: str, session_id: str | None = None) -> dict:
        session_id = session_id or str(uuid.uuid4())
        result = await self.agent.ainvoke(
            {"messages": [{"role": "user", "content": query}]},
            config={"configurable": {"thread_id": session_id}},
        )
        return {"answer": result["messages"][-1].text, "session_id": session_id}
