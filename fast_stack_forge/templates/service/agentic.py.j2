{% import "_providers.j2" as p %}
"""{{ service_name }} — agentic workflow as an explicit LangGraph graph ({{ provider }}).

llm_call ──(tool calls?)──▶ tools ──▶ llm_call ... ──(no tool call)──▶ END
Add nodes and edges in _build_graph to shape your own workflow.
"""

import uuid

from decouple import config
from langchain_core.messages import HumanMessage, SystemMessage
from langchain_core.tools import tool
from langgraph.checkpoint.memory import InMemorySaver
from langgraph.graph import END, START, MessagesState, StateGraph
from langgraph.prebuilt import ToolNode, tools_condition
{{ p.imports(provider) }}
SYSTEM_PROMPT = "You are a helpful assistant. Use the tools when they help you answer."
MAX_STEPS = config("{{ service_name_upper }}_MAX_STEPS", default=10, cast=int)


@tool
def add(a: float, b: float) -> float:
    """Add two numbers."""
    return a + b


@tool
def multiply(a: float, b: float) -> float:
    """Multiply two numbers."""
    return a * b


class {{ service_name }}Service:
    def __init__(self):
        self.llm = {{ p.chat_model(provider) }}
        self.tools = [add, multiply]
        self.llm_with_tools = self.llm.bind_tools(self.tools)
        self.graph = self._build_graph()

    def _build_graph(self):
        async def llm_call(state: MessagesState):
            messages = [SystemMessage(SYSTEM_PROMPT), *state["messages"]]
            return {"messages": [await self.llm_with_tools.ainvoke(messages)]}

        builder = StateGraph(MessagesState)
        builder.add_node("llm_call", llm_call)
        builder.add_node("tools", ToolNode(self.tools))
        builder.add_edge(START, "llm_call")
        builder.add_conditional_edges("llm_call", tools_condition, ["tools", END])
        builder.add_edge("tools", "llm_call")
        # In-process memory per session_id; use a persistent checkpointer in production.
        return builder.compile(checkpointer=InMemorySaver())

    async def invoke(self, query: str, session_id: str | None = None) -> dict:
        session_id = session_id or str(uuid.uuid4())
        result = await self.graph.ainvoke(
            {"messages": [HumanMessage(query)]},
            # each llm_call + tools round trip is 2 steps
            config={"configurable": {"thread_id": session_id}, "recursion_limit": 2 * MAX_STEPS + 1},
        )
        return {"answer": result["messages"][-1].text, "session_id": session_id}
