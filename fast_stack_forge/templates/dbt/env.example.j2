# Copy to .env and fill in. The Makefile exports these variables to dbt.
[% if adapter == 'duckdb' %]
DUCKDB_PATH=[[ project_name ]].duckdb
[% elif adapter == 'postgres' %]
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
DBT_SCHEMA=dev
[% elif adapter == 'snowflake' %]
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
DBT_SCHEMA=dev
[% elif adapter == 'bigquery' %]
BQ_PROJECT=
BQ_KEYFILE=/path/to/service-account.json
BQ_LOCATION=EU
DBT_SCHEMA=dev
[% elif adapter == 'databricks' %]
# Workspace host WITHOUT https://, e.g. adb-1234567890.12.azuredatabricks.net
DBT_HOST=
# Personal access token (or run `databricks auth token`)
DBT_ACCESS_TOKEN=
DBT_HTTP_PATH=/sql/1.0/warehouses/[[ warehouse_id or '<warehouse-id>' ]]
DBT_CATALOG=[[ catalog ]]
DBT_SCHEMA=dev
[% endif %]
