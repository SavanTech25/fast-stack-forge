name: '[[ project_name ]]'
version: '1.0.0'
config-version: 2

profile: '[[ project_name ]]'

model-paths: ["models"]
analysis-paths: ["analyses"]
test-paths: ["tests"]
seed-paths: ["seeds"]
macro-paths: ["macros"]
snapshot-paths: ["snapshots"]

clean-targets:
  - "target"
  - "dbt_packages"

seeds:
  [[ project_name ]]:
    +schema: raw

models:
  [[ project_name ]]:
    +materialized: table
    # [[ arch.help ]]
    [[ arch.layers[0] ]]:
      +materialized: view
      +tags: ['[[ arch.layers[0] ]]']
    [[ arch.layers[1] ]]:
      +materialized: [[ 'view' if archi == 'default' else 'table' ]]
      +tags: ['[[ arch.layers[1] ]]']
    [[ arch.layers[2] ]]:
      +materialized: table
      +tags: ['[[ arch.layers[2] ]]']
