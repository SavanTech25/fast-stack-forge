[project]
name = "[[ project_name ]]"
version = "0.1.0"
description = "[[ description ]]"
readme = "README.md"
requires-python = ">=[[ python_version ]]"
dependencies = [
[% for dep in dependencies %]
    "[[ dep ]]",
[% endfor %]
]

[tool.uv]
# A dbt project is not a Python package: only install its dependencies
package = false
